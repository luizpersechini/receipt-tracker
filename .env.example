# Receipt Tracker — environment config (copy to .env and edit)

# Local folder watched for auto-ingest. Leave blank to disable.
# Supported: .jpg .jpeg .png .heic .heif .pdf
WATCH_FOLDER=

# Ollama vision model used for OCR. Must be in the allowlist in
# src/services/llm_processor.py (glm-ocr, llava, moondream, qwen2-vl, etc.)
# and below OCR_MAX_MODEL_GB.
OLLAMA_MODEL=glm-ocr:latest

# Optional Ollama host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# OCR safety rails — these protect a laptop from getting stuck on a huge
# model or a 12-megapixel image. Tune cautiously.
#
# Longest-edge resize applied to every receipt image before it hits Ollama.
# 1536 px is plenty for OCR; receipts at the original 4032 px will thrash a
# vision model.
OCR_MAX_IMAGE_DIM=1536
#
# Hard cap on model size. Any installed model larger than this will be
# rejected with a clear error instead of being silently loaded. 6 GB keeps
# you safely on small vision models like glm-ocr / moondream / llava-7b.
OCR_MAX_MODEL_GB=6.0
#
# Per-call timeout for a single OCR request. After this many seconds the
# call is aborted and the receipt is saved with an error metadata field.
OCR_TIMEOUT_SECONDS=120
#
# Max concurrent OCR jobs. Vision models are memory-heavy on Apple Silicon;
# parallelism = freeze. Leave at 1 unless you have ≥32 GB unified memory.
OCR_CONCURRENCY=1
#
# Pre-load the vision model when the server starts. Costs a few seconds of
# background work but means the first user upload doesn't pay the cold-start
# tax. Set to false on tight-memory machines where you don't always need OCR.
OCR_WARMUP=true
#
# Optional pre-OCR image clean-up: EXIF auto-rotate + CLAHE local-contrast +
# unsharp mask. Helps for hard-to-read phone photos with any backend, but
# can over-amplify already-clean scans. Off by default.
OCR_PREPROCESS=false
#
# OCR backend. Leave BLANK to auto-pick the right on-device engine for your
# platform: apple_vision on macOS, paddle_ocr on Windows/Linux.
#   apple_vision — macOS only. On-device Apple Vision OCR for text extraction
#                   (fast, accurate on printed text, no vision encoder
#                   resident) + a small text LLM (OCR_TEXT_MODEL) to structure
#                   it. The default ON macOS.
#   paddle_ocr   — cross-platform (Windows/Linux). PaddleOCR (PP-OCR) for local
#                   on-device text extraction + the SAME text LLM to structure.
#                   The default OFF macOS. Needs `pip install paddleocr
#                   paddlepaddle` (CPU); first run downloads the small models.
#                   This is the Windows equivalent of apple_vision.
#   ollama_vision — one Ollama vision-model call per crop. Works on any
#                   platform but needs a vision model that follows a JSON
#                   instruction (llava, minicpm-v). The shipped OLLAMA_MODEL
#                   (glm-ocr) is OCR-only and LOOPS on the extraction prompt —
#                   do not pair it with this backend.
OCR_BACKEND=
#
# Text-only model used by the apple_vision / paddle_ocr backends to structure
# raw text into JSON. llama3.2:3b (~2 GB) is the sweet spot for accuracy+speed.
OCR_TEXT_MODEL=llama3.2:3b
#
# PaddleOCR (paddle_ocr backend) options.
#   PADDLE_LANG     recognition language. "pt" covers pt-BR + Latin scripts;
#                   "en", "ch", "latin", "ml" etc. are also supported.
#   PADDLE_USE_GPU  CPU by default. true needs paddlepaddle-gpu + CUDA.
PADDLE_LANG=pt
PADDLE_USE_GPU=false
#   PADDLE_TEXT_DET_MODEL / PADDLE_TEXT_REC_MODEL  override the per-language
#                   default models (PaddleOCR 3.x). Blank = default. Detection
#                   is language-agnostic — a stronger detector helps when totals
#                   aren't being read: PADDLE_TEXT_DET_MODEL=PP-OCRv5_server_det.
#                   Recognition is language-specific (pt-BR default is the
#                   multilingual PP-OCRv6_medium_rec; latin_PP-OCRv5_mobile_rec
#                   is a latin-specialized alternative). First use downloads it.
PADDLE_TEXT_DET_MODEL=
PADDLE_TEXT_REC_MODEL=
#
# Structuring backend — which LLM turns the OCR'd text into receipt JSON.
# SEPARATE from OCR: the OCR always runs locally; only this LLM changes.
#   ollama    — local Ollama text model (OCR_TEXT_MODEL). Default; fully local.
#   anthropic — hosted Claude API. Lets a low-powered machine use a much
#               stronger model for the accuracy-critical structuring step.
#               Sends only the receipt TEXT (never the image) to the API.
#               Requires ANTHROPIC_API_KEY. The structuring task is simple +
#               high-volume, so claude-haiku-4-5 is ample and the cheapest —
#               set ANTHROPIC_MODEL=claude-haiku-4-5 for pennies/month.
STRUCTURE_BACKEND=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Gmail ingestion (Phase B of the Uber integration) ──────────────────────
# Pulls Uber receipt emails from Gmail and creates receipts automatically.
# One-time setup: run `python3 scripts/gmail_auth.py` after putting
# credentials.json at GMAIL_CREDENTIALS_PATH.
GMAIL_CREDENTIALS_PATH=data/gmail/credentials.json
GMAIL_TOKEN_PATH=data/gmail/token.json
#
# Gmail search query. Default catches both Uber addresses. Add extra clauses
# (newer_than:30d, label:Travel, etc.) to narrow the scan.
GMAIL_QUERY=from:(noreply@uber.com OR receipts@uber.com)
#
# Label applied to processed messages so they're not re-imported. Will be
# auto-created in Gmail on first sync.
GMAIL_PROCESSED_LABEL=rt-processed
#
# Hard cap per sync run.
GMAIL_MAX_MESSAGES_PER_SYNC=100

# Paths (override only if you need to move state outside the project)
# DB_PATH=data/receipt_tracker.db
# UPLOAD_DIR=data
